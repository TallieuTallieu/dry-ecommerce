{
  "name": "tallieutallieu/dry-ecommerce",
  "description": "E-commerce package",
  "type": "library",
  "license": "proprietary",
  "minimum-stability": "beta",
  "require": {
    "php": ">=8.4",
    "tallieutallieu/dry": "^4.0",
    "tallieutallieu/dry-dbi": "^3.0",
    "tallieutallieu/oak": "^3.0"
  },
  "require-dev": {
    "pestphp/pest": "^3.8",
    "phpstan/phpstan": "^2.1",
    "tallieutallieu/dry-accounts": "^3"
  },
  "autoload": {
    "psr-4": {
      "Tnt\\Ecommerce\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=512M",
    "phpstan:baseline": "phpstan analyse --memory-limit=512M --generate-baseline"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@bitbucket.org:tallieu/dry3.git"
    }
  ]
}
